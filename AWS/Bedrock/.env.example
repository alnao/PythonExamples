# Configurazione del backend (copiare in .env). Sull'EC2 il file .env lo scrive lo user data.
AWS_REGION=eu-central-1
S3_BUCKET=bedrock-alnao-bucket

# Modelli Bedrock (Converse API). I profili "eu." instradano le richieste nelle region europee.
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
CHAT_MODEL=eu.amazon.nova-lite-v1:0
# temperature del modello di chat; lasciare vuoto per i modelli Claude 5.x, che non la accettano
CHAT_TEMPERATURE=0.2
# immagini: Amazon Nova Lite (circa 0,0003 $ a immagine); vuoto = OCR locale con Tesseract,
# gratis ma legge solo il testo (nessuna descrizione del contenuto)
IMAGE_MODEL=eu.amazon.nova-lite-v1:0

# Chiave delle API (header X-API-Key): diretta in locale, parametro SSM SecureString sull'EC2
API_KEY=cambiami
#API_KEY_PARAMETER=/Bedrock/api-key

# CORS, solo se il sito e' servito da un'altra origine (separate da virgola)
ALLOWED_ORIGINS=

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_UPLOAD_MB=20
