# Data Export (CUR 2.0) su S3: sorgente gratuita dei costi per il Cost Explorer e la Home.
# Per ogni mese l'app usa i file dell'export se ci sono, altrimenti la cache dei mesi
# letti con l'API di Cost Explorer (a pagamento). Senza CUR_S3_BUCKET l'export non si usa.
# Copiare in .env e adattare.

# bucket e prefisso di destinazione dell'export (Billing -> Data Exports)
CUR_S3_BUCKET=nome-del-bucket
CUR_S3_PREFIX=prefisso-dell-export
# region del bucket
CUR_S3_REGION=eu-central-1
# nome dell'export: filtra i file se nello stesso prefisso ci sono piu' export
CUR_EXPORT_NAME=NomeExport
# profilo AWS per leggere il bucket (vuoto = il profilo scelto nella navbar)
CUR_AWS_PROFILE=
# ogni quanti secondi rileggere l'elenco dei file su S3
CUR_LIST_TTL=600
