  },
  "terraform": {
    "_comment": "Bucket S3 con gli state di Terraform (backend s3): la sezione Terraform legge i file che finiscono con uno dei state_suffixes (al massimo max_states per bucket) e mostra le risorse gestite con tipo, region e tag.",
    "buckets": [
      "alnao-production-terraform",
      "alnao-dev-terraform",
      "pathsgames-production-iac",
      "pathsgames-test-iac"
    ],
    "state_suffixes": [".tfstate"],
    "max_states": 200
  },
  "manager": {
    "_comment": "max_upload_mb: dimensione massima dei file caricati su S3; list_limit: massimo di oggetti S3, righe DynamoDB per pagina, eventi di log ed esecuzioni mostrati; dynamodb_max_read: righe lette al massimo da uno Scan con filtro per ogni 'Carica dati' (le righe lette consumano capacita' anche se il filtro le scarta).",
    "max_upload_mb": 10,
    "list_limit": 500,
    "logs_limit": 100,
    "dynamodb_max_read": 5000
  }
